#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Graphite {
            bindings = <
        //  b l d w z  ' f o u j
        //  n r t s g  y h a e i
        //  q x m c v  k p . / ,
        //    nums repeat/tab space
        //    enter esc bksp
&trans  &kp B  &kp L  &kp D  &kp W  &kp Z                                      &kp SQT  &kp F  &kp O  &kp U  &kp J  &trans
&trans  &mt LEFT_CONTROL N  &mt LEFT_ALT R  &mt LEFT_GUI T  &lt 1 S  &kp G     &kp Y  &lt 1 H  &mt RIGHT_GUI A  &mt RIGHT_ALT E  &mt RIGHT_CONTROL I  &trans
&trans  &kp Q  &kp X  &kp M  &kp C  &kp V                                      &kp K  &kp P  &kp PERIOD  &kp SLASH  &kp COMMA  &trans
                                     &mo 5  &kp TAB  &kp SPACE     &kp ENTER  &kp ESCAPE  &kp BACKSPACE
            >;
        };

        Graphite_Caps {
            bindings = <
        //  B L D W Z  " F O U J
        //  N R T S G  Y H A E I
        //  Q X M C V  K P : ? ;
&trans  &kp LS(B)  &kp LS(L)  &kp LS(D)  &kp LS(W)  &kp LS(Z)    &kp DQT  &kp LS(F)  &kp LS(O)      &kp LS(U)      &kp LS(J)  &trans
&trans  &kp LS(N)  &kp LS(R)  &kp LS(T)  &kp LS(S)  &kp LS(G)    &kp LS(Y)    &kp LS(H)  &kp LS(A)      &kp LS(E)      &kp LS(I)  &trans
&trans  &kp LS(Q)  &kp LS(X)  &kp LS(M)  &kp LS(C)  &kp LS(V)    &kp LS(K)    &kp LS(P)  &kp COLON  &kp QMARK  &kp SEMI  &trans
                              &trans     &trans     &trans       &trans       &trans     &trans
            >;
        };

        Colemak {
            bindings = <
&trans  &kp Q  &kp W  &kp F  &kp P   &kp B     &kp J   &kp L   &kp U      &kp Y    &kp SEMI  &trans
&trans  &mt LEFT_CONTROL A  &mt LEFT_ALT R  &mt LEFT_GUI S  &mt LEFT_SHIFT T   &kp G     &kp M   &mt RIGHT_SHIFT N   &mt RIGHT_GUI E     &mt RIGHT_ALT I   &mt RIGHT_CONTROL O  &trans
&trans  &kp X  &kp C  &kp D  &kp V   &kp Z     &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &to 0  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Qwerty {
            bindings = <
&trans  &kp Q  &kp W  &kp E  &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P  &trans
&trans  &kp A  &kp S  &kp D  &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z  &kp X  &kp C  &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &to 0  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Symbols {
            bindings = <
&trans  &kp GRAVE      &kp LT    &kp GT  &kp MINUS  &kp PIPE     &kp UNDER  &kp LBRC   &kp RBRC  &kp DLLR  &kp CARET  &trans
&trans  &kp EXCL   &kp STAR  &kp FSLH    &kp EQUAL  &kp AMPS     &kp HASH   &kp LPAR   &kp RPAR  &kp SEMI      &kp DQT  &trans
&trans  &kp TILDE  &kp PLUS  &kp LBKT    &kp RBKT   &kp PRCNT    &kp AT     &kp COLON  &kp BSLH     &kp DOT       &kp SQT  &trans
                                     &to 0       &trans     &trans           &trans         &to 0         &trans
            >;
        };

        Numpad {
            bindings = <
&trans  &bootloader  &sys_reset  &bt BT_PRV  &bt BT_NXT  &trans    &kp PLUS  &kp N1      &kp N2     &kp N3  &kp STAR  &trans
&trans  &to 6        &kp LEFT_SHIFT(GUI(W))      &kp GUI(F)      &to 4       &trans    &kp MINUS     &kp N4      &kp N5     &kp N6  &kp FSLH  &trans
&trans  &to 3        &kp K_COPY      &kp K_PASTE     &to 2       &trans    &kp X         &kp N7      &kp N8     &kp N9  &kp PRCNT  &trans
                                 &trans      &trans      &trans    &kp N0        &kp PERIOD  &kp COMMA
            >;
        };

        Nav {
            bindings = <
&trans  &kp F1      &kp F2       &kp F3    &kp F4     &kp F5           &kp F6    &kp F7   &kp F8    &kp F9     &kp F10  &trans
&trans  &kp LCTRL   &kp LGUI     &kp LALT  &kp LSHFT  &kp PAGE_UP      &kp LEFT  &kp UP   &kp DOWN  &kp RIGHT  &kp F11  &trans
&trans  &sys_reset  &bootloader  &trans    &trans     &kp PAGE_DOWN    &kp HOME  &kp END  &trans    &trans     &kp F12  &trans
                                 &to 0     &trans     &trans           &trans    &to 0   &trans
            >;
        };
    };
};
